# WordBloom — Google Cloud Configuration (Example)
# Copy this file to .env and replace with your Google Cloud Project ID:
#   cp wordbloom_agent/.env.example wordbloom_agent/.env

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
MODEL_ARMOR_TEMPLATE_ID=wordbloom-child-guard

